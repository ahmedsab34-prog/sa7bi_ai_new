
const DEFAULT_LIMIT_BYTES = 8 * 1024 * 1024 * 1024;
const DEFAULT_WARNING_BYTES = 7 * 1024 * 1024 * 1024;

function ensureQuotaTables(actor) {
  const sql = actor?.ctx?.storage?.sql;

  if (!sql || typeof sql.exec !== "function") {
    throw new Error("STORAGE_SQL_UNAVAILABLE");
  }

  sql.exec(`
    CREATE TABLE IF NOT EXISTS sa7bi_storage_objects (
      object_key TEXT PRIMARY KEY,
      provider TEXT NOT NULL,
      size_bytes INTEGER NOT NULL,
      state TEXT NOT NULL,
      reservation_id TEXT NOT NULL UNIQUE,
      version_id TEXT,
      created_at INTEGER NOT NULL,
      updated_at INTEGER NOT NULL
    )
  `);

  sql.exec(`
    CREATE INDEX IF NOT EXISTS sa7bi_storage_objects_state_idx
    ON sa7bi_storage_objects(state, provider)
  `);
}

function readUsage(actor) {
  const row = actor.ctx.storage.sql.exec(
    `SELECT
       COALESCE(SUM(size_bytes), 0) AS used_bytes,
       COUNT(*) AS object_count
     FROM sa7bi_storage_objects
     WHERE provider = 'b2'
       AND state IN ('reserved', 'stored')`,
  ).toArray()[0] || {};

  return {
    usedBytes: Number(row.used_bytes) || 0,
    objectCount: Number(row.object_count) || 0,
  };
}

function getLimits(env = {}) {
  const configuredLimit = Number(env.SA7BI_B2_MAX_BYTES);
  const configuredWarning = Number(env.SA7BI_B2_WARNING_BYTES);

  const limitBytes =
    Number.isSafeInteger(configuredLimit) && configuredLimit > 0
      ? configuredLimit
      : DEFAULT_LIMIT_BYTES;

  const warningBytes =
    Number.isSafeInteger(configuredWarning) &&
    configuredWarning > 0 &&
    configuredWarning < limitBytes
      ? configuredWarning
      : Math.min(DEFAULT_WARNING_BYTES, limitBytes);

  return { limitBytes, warningBytes };
}

function getStorageStatus(actor) {
  ensureQuotaTables(actor);

  const usage = readUsage(actor);
  const limits = getLimits(actor.env);

  return {
    provider: "b2",
    usedBytes: usage.usedBytes,
    objectCount: usage.objectCount,
    limitBytes: limits.limitBytes,
    warningBytes: limits.warningBytes,
    remainingBytes: Math.max(
      0,
      limits.limitBytes - usage.usedBytes,
    ),
    warning: usage.usedBytes >= limits.warningBytes,
    full: usage.usedBytes >= limits.limitBytes,
  };
}

function reserveStorage(actor, { objectKey, sizeBytes }) {
  ensureQuotaTables(actor);

  if (
    typeof objectKey !== "string" ||
    !objectKey.trim() ||
    objectKey.length > 1024
  ) {
    throw new Error("INVALID_STORAGE_OBJECT_KEY");
  }

  if (
    !Number.isSafeInteger(sizeBytes) ||
    sizeBytes <= 0
  ) {
    throw new Error("INVALID_STORAGE_SIZE");
  }

  const reservationId = crypto.randomUUID();
  const now = Date.now();
  const limits = getLimits(actor.env);

  return actor.ctx.storage.transactionSync(() => {
    const existing = actor.ctx.storage.sql.exec(
      `SELECT object_key
       FROM sa7bi_storage_objects
       WHERE object_key = ?`,
      objectKey,
    ).toArray()[0];

    if (existing) {
      throw new Error("STORAGE_OBJECT_ALREADY_REGISTERED");
    }

    const usage = readUsage(actor);

    if (usage.usedBytes + sizeBytes > limits.limitBytes) {
      throw new Error("STORAGE_CAPACITY_EXCEEDED");
    }

    actor.ctx.storage.sql.exec(
      `INSERT INTO sa7bi_storage_objects
       (object_key, provider, size_bytes, state,
        reservation_id, version_id, created_at, updated_at)
       VALUES (?, 'b2', ?, 'reserved', ?, NULL, ?, ?)`,
      objectKey,
      sizeBytes,
      reservationId,
      now,
      now,
    );

    return {
      reservationId,
      objectKey,
      sizeBytes,
      usedBytes: usage.usedBytes + sizeBytes,
      limitBytes: limits.limitBytes,
      warning: usage.usedBytes + sizeBytes >= limits.warningBytes,
    };
  });
}

function commitStorageReservation(
  actor,
  { reservationId, objectKey, versionId },
) {
  ensureQuotaTables(actor);

  if (
    typeof reservationId !== "string" ||
    !reservationId ||
    typeof objectKey !== "string" ||
    !objectKey ||
    typeof versionId !== "string" ||
    !versionId
  ) {
    throw new Error("INVALID_STORAGE_COMMIT");
  }

  return actor.ctx.storage.transactionSync(() => {
    const result = actor.ctx.storage.sql.exec(
      `UPDATE sa7bi_storage_objects
       SET state = 'stored',
           version_id = ?,
           updated_at = ?
       WHERE reservation_id = ?
         AND object_key = ?
         AND provider = 'b2'
         AND state = 'reserved'`,
      versionId,
      Date.now(),
      reservationId,
      objectKey,
    );

    if (result.rowsWritten !== 1) {
      throw new Error("STORAGE_RESERVATION_NOT_FOUND");
    }

    return getStorageStatus(actor);
  });
}

function releaseStorageReservation(
  actor,
  { reservationId, objectKey },
) {
  ensureQuotaTables(actor);

  return actor.ctx.storage.transactionSync(() => {
    const result = actor.ctx.storage.sql.exec(
      `DELETE FROM sa7bi_storage_objects
       WHERE reservation_id = ?
         AND object_key = ?
         AND provider = 'b2'
         AND state = 'reserved'
         AND version_id IS NULL`,
      reservationId,
      objectKey,
    );

    return {
      released: result.rowsWritten === 1,
      status: getStorageStatus(actor),
    };
  });
}

function releaseDeletedStorageObject(
  actor,
  { objectKey, versionId },
) {
  ensureQuotaTables(actor);

  if (
    typeof objectKey !== "string" ||
    !objectKey ||
    typeof versionId !== "string" ||
    !versionId
  ) {
    throw new Error("EXACT_VERSION_REQUIRED");
  }

  return actor.ctx.storage.transactionSync(() => {
    const result = actor.ctx.storage.sql.exec(
      `DELETE FROM sa7bi_storage_objects
       WHERE object_key = ?
         AND provider = 'b2'
         AND state = 'stored'
         AND version_id = ?`,
      objectKey,
      versionId,
    );

    return {
      released: result.rowsWritten === 1,
      status: getStorageStatus(actor),
    };
  });
}

export {
  ensureQuotaTables,
  getStorageStatus,
  reserveStorage,
  commitStorageReservation,
  releaseStorageReservation,
  releaseDeletedStorageObject,
};
